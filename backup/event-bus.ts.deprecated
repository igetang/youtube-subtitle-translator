/**
 * @deprecated ⚠️ 此类已废弃，请使用MessageBus替代
 * 
 * 🚨 重要提醒：
 * - EventBus架构已被MessageBus取代
 * - 新代码请使用 import { MessageBus } from './message-bus'
 * - 迁移指南：docs/migration-eventbus-to-messagebus.md
 * 
 * 迁移对照：
 * - eventBus.emit() → messageBus.sendMessage()
 * - eventBus.on() → messageBus.registerRoute()
 * - EventTypes.* → MessageType.*
 */

/**
 * @file event-bus.ts
 * @description 事件总线系统，实现发布/订阅机制，支持事件过滤和日志记录
 */

/**
 * 事件优先级
 */
export enum EventPriority {
  LOW = 0,    // 低优先级，最后处理
  NORMAL = 1, // 普通优先级，默认级别
  HIGH = 2,   // 高优先级，较早处理
  CRITICAL = 3 // 关键优先级，最先处理
}

/**
 * 事件处理函数类型
 */
export type EventHandler<T = any> = (eventData: T) => void;

/**
 * 事件处理器配置
 */
interface EventHandlerConfig<T = any> {
  handler: EventHandler<T>;
  priority: EventPriority;
  once: boolean;
}

/**
 * 事件总线配置选项
 */
export interface EventBusOptions {
  /**
   * 是否启用事件日志记录
   */
  enableLogging?: boolean;
  
  /**
   * 保留的最大日志数量
   */
  maxLogSize?: number;
  
  /**
   * 是否允许同步执行事件处理函数
   * 如果为false，则所有处理函数通过setTimeout异步执行
   */
  synchronousExecution?: boolean;
}

/**
 * 事件日志条目
 */
export interface EventLogEntry {
  /**
   * 事件类型
   */
  eventType: string;
  
  /**
   * 事件数据
   */
  data: any;
  
  /**
   * 触发时间戳
   */
  timestamp: number;
  
  /**
   * 处理器数量
   */
  handlersCount: number;
}

/**
 * 事件总线类
 * 提供发布/订阅机制，支持事件过滤和优先级
 */
export class EventBus {
  private static instance: EventBus;
  private handlers: Map<string, EventHandlerConfig[]> = new Map();
  private wildcardHandlers: EventHandlerConfig[] = [];
  private eventLog: EventLogEntry[] = [];
  private options: Required<EventBusOptions>;
  
  /**
   * 默认配置选项
   */
  private static readonly DEFAULT_OPTIONS: Required<EventBusOptions> = {
    enableLogging: true,
    maxLogSize: 100,
    synchronousExecution: true
  };
  
  /**
   * 私有构造函数，防止直接实例化
   */
  private constructor(options?: EventBusOptions) {
    // ⚠️ 废弃警告
    console.warn(
      '🚨 [DEPRECATED] EventBus已废弃，请迁移到MessageBus\n' +
      '📖 迁移指南: docs/migration-eventbus-to-messagebus.md\n' +
      '🔄 新API: import { MessageBus } from "./message-bus"'
    );
    
    this.options = {
      ...EventBus.DEFAULT_OPTIONS,
      ...options
    };
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(options?: EventBusOptions): EventBus {
    if (!EventBus.instance) {
      EventBus.instance = new EventBus(options);
    }
    return EventBus.instance;
  }
  
  /**
   * 订阅事件
   * @param eventType 事件类型，使用 '*' 订阅所有事件
   * @param handler 事件处理函数
   * @param priority 事件优先级，默认为普通优先级
   * @returns 用于取消订阅的函数
   */
  public on<T = any>(
    eventType: string,
    handler: EventHandler<T>,
    priority: EventPriority = EventPriority.NORMAL
  ): () => void {
    const config: EventHandlerConfig<T> = {
      handler,
      priority,
      once: false
    };
    
    if (eventType === '*') {
      this.wildcardHandlers.push(config);
      this.sortHandlersByPriority(this.wildcardHandlers);
      
      return () => this.off(eventType, handler);
    } else {
      if (!this.handlers.has(eventType)) {
        this.handlers.set(eventType, []);
      }
      
      this.handlers.get(eventType)!.push(config);
      this.sortHandlersByPriority(this.handlers.get(eventType)!);
      
      return () => this.off(eventType, handler);
    }
  }
  
  /**
   * 订阅事件，仅触发一次后自动取消订阅
   * @param eventType 事件类型，使用 '*' 订阅所有事件
   * @param handler 事件处理函数
   * @param priority 事件优先级，默认为普通优先级
   * @returns 用于取消订阅的函数
   */
  public once<T = any>(
    eventType: string,
    handler: EventHandler<T>,
    priority: EventPriority = EventPriority.NORMAL
  ): () => void {
    const config: EventHandlerConfig<T> = {
      handler,
      priority,
      once: true
    };
    
    if (eventType === '*') {
      this.wildcardHandlers.push(config);
      this.sortHandlersByPriority(this.wildcardHandlers);
      
      return () => this.off(eventType, handler);
    } else {
      if (!this.handlers.has(eventType)) {
        this.handlers.set(eventType, []);
      }
      
      this.handlers.get(eventType)!.push(config);
      this.sortHandlersByPriority(this.handlers.get(eventType)!);
      
      return () => this.off(eventType, handler);
    }
  }
  
  /**
   * 取消订阅事件
   * @param eventType 事件类型
   * @param handler 事件处理函数，不提供则移除该事件类型的所有处理函数
   * @returns 是否成功取消订阅
   */
  public off<T = any>(eventType: string, handler?: EventHandler<T>): boolean {
    if (eventType === '*') {
      if (handler) {
        const initialLength = this.wildcardHandlers.length;
        this.wildcardHandlers = this.wildcardHandlers.filter(
          config => config.handler !== handler
        );
        return initialLength > this.wildcardHandlers.length;
      } else {
        const hadHandlers = this.wildcardHandlers.length > 0;
        this.wildcardHandlers = [];
        return hadHandlers;
      }
    } else {
      if (!this.handlers.has(eventType)) {
        return false;
      }
      
      if (handler) {
        const handlers = this.handlers.get(eventType)!;
        const initialLength = handlers.length;
        
        const filtered = handlers.filter(config => config.handler !== handler);
        
        if (filtered.length === 0) {
          this.handlers.delete(eventType);
        } else {
          this.handlers.set(eventType, filtered);
        }
        
        return initialLength > filtered.length;
      } else {
        const hadHandlers = this.handlers.has(eventType);
        this.handlers.delete(eventType);
        return hadHandlers;
      }
    }
  }
  
  /**
   * 触发事件
   * @param eventType 事件类型
   * @param data 事件数据
   * @returns 处理函数的数量
   */
  public emit<T = any>(eventType: string, data?: T): number {
    const specificHandlers = this.handlers.get(eventType) || [];
    let handlersToExecute = [...specificHandlers];
    
    // 添加通配符处理函数
    if (this.wildcardHandlers.length > 0) {
      handlersToExecute = [...handlersToExecute, ...this.wildcardHandlers];
      
      // 重新排序
      this.sortHandlersByPriority(handlersToExecute);
    }
    
    // 记录事件日志
    if (this.options.enableLogging) {
      this.logEvent(eventType, data, handlersToExecute.length);
    }
    
    // 没有处理函数则直接返回
    if (handlersToExecute.length === 0) {
      return 0;
    }
    
    // 执行处理函数
    handlersToExecute.forEach(config => {
      try {
        if (this.options.synchronousExecution) {
          // 同步执行
          config.handler(data);
        } else {
          // 异步执行（通过setTimeout）
          setTimeout(() => {
            config.handler(data);
          }, 0);
        }
      } catch (error) {
        console.error(`[event-bus] 事件处理函数执行错误 (事件: ${eventType}):`, error);
      }
      
      // 如果是一次性处理函数，执行后移除
      if (config.once) {
        this.off(eventType, config.handler);
      }
    });
    
    return handlersToExecute.length;
  }
  
  /**
   * 获取特定事件类型的处理函数数量
   * @param eventType 事件类型
   * @returns 处理函数数量
   */
  public listenerCount(eventType: string): number {
    const specificHandlers = this.handlers.get(eventType)?.length || 0;
    
    // 如果请求的是通配符处理函数数量
    if (eventType === '*') {
      return this.wildcardHandlers.length;
    }
    
    // 对于特定事件类型，返回特定处理函数数量
    return specificHandlers;
  }
  
  /**
   * 获取已注册的所有事件类型
   * @returns 事件类型数组
   */
  public eventTypes(): string[] {
    return [...this.handlers.keys()];
  }
  
  /**
   * 清除所有事件处理函数
   */
  public clear(): void {
    this.handlers.clear();
    this.wildcardHandlers = [];
  }
  
  /**
   * 获取事件日志
   * @returns 事件日志数组
   */
  public getEventLog(): EventLogEntry[] {
    return [...this.eventLog];
  }
  
  /**
   * 清除事件日志
   */
  public clearEventLog(): void {
    this.eventLog = [];
  }
  
  /**
   * 记录事件到日志
   */
  private logEvent(eventType: string, data: any, handlersCount: number): void {
    const logEntry: EventLogEntry = {
      eventType,
      data,
      timestamp: Date.now(),
      handlersCount
    };
    
    this.eventLog.push(logEntry);
    
    // 限制日志大小
    if (this.eventLog.length > this.options.maxLogSize) {
      this.eventLog = this.eventLog.slice(-this.options.maxLogSize);
    }
  }
  
  /**
   * 按优先级排序处理函数
   */
  private sortHandlersByPriority(handlers: EventHandlerConfig[]): void {
    handlers.sort((a, b) => b.priority - a.priority);
  }
} 