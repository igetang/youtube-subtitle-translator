{
  "manifest_version": 3,
  "name": "项目名称 (待定)",
  "version": "0.0.1",
  "description": "扩展描述 (待定)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png",
        "icons/off.svg",
        "icons/on.svg",
        "icons/l-setting.svg",
        "icons/l-setting-active.svg",
        "icons/normal-border.svg",
        "src/main-world.js"
       ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
} 