{
  "name": "youtube-subtitle-translator",
  "version": "1.0.0",
  "description": "YouTube字幕翻译助手 - 为YouTube视频提供实时字幕翻译功能的Chrome扩展",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:content\"",
    "dev:main": "vite build --watch",
    "dev:content": "vite build --watch --mode content-script",
    "build": "npm run build:main && npm run build:content && npm run build:mainworld && npm run build:worker && npm run fix:worker",
    "build:main": "vite build",
    "build:content": "vite build --mode content-script",
    "build:mainworld": "vite build --mode main-world",
    "build:worker": "vite build --mode service-worker",
    "fix:worker": "node scripts/fix-service-worker.js",
    "package": "node scripts/package.js"
  },
  "keywords": [
    "chrome-extension",
    "youtube",
    "subtitle",
    "translation",
    "字幕翻译"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.3",
    "@upstash/context7-mcp": "^1.0.16",
    "archiver": "^7.0.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-static-copy": "^2.3.1"
  },
  "dependencies": {
    "@pimzino/spec-workflow-mcp": "^1.0.1"
  }
}
